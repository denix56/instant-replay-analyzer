# Native runtime settings.
CLIPS_DIR=./clips
HOST_CLIPS_DIR=./clips
DATA_DIR=./data
MODELS_DIR=./models

# Local backend.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Runtime profile: auto, nvidia, amd, macos, or cpu.
RUNTIME_PROFILE=auto
MODEL_TIER=default
INDEXING_PROFILE=balanced
GPU_BACKEND=unknown

# Embedded/local vector store.
QDRANT_URL=local
VECTOR_BACKEND=qdrant

# App-managed model runtime.
AUTO_DOWNLOAD_MODELS=true
FFMPEG_BINARY=
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
QWEN_REASONING_MODE=off
QWEN_REASONING_BUDGET_TOKENS=1024
ALLOW_MOCK_MODELS=false
ALLOW_CONCURRENT_MODEL_SERVERS=false
MODEL_SERVER_BASE_PORT=18100
MODEL_SERVER_START_TIMEOUT_SEC=60
MODEL_SERVER_IDLE_TIMEOUT_SEC=60
MODEL_GPU_LAYERS=999
ASR_LANGUAGE=auto

# Feature toggles.
ENABLE_TRANSCRIPTION=true
ENABLE_RERANKING=true
ENABLE_DEEP_REASONING=false
ENABLE_OCR=false
ENABLE_AUDIO_EVENT_DETECTION=false

# Retrieval.
SEARCH_MIN_SCORE=0.35
SEARCH_CANDIDATE_LIMIT=100
VIDEO_EMBEDDING_FPS=6.0
VIDEO_EMBEDDING_MAX_FRAMES=150

# Scoring weights.
AV_SEGMENT_WEIGHT=0.55
TRANSCRIPT_WEIGHT=0.25
METADATA_WEIGHT=0.05
RERANKER_WEIGHT=0.15
